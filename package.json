{
  "name": "ipe-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'dist/**'",
    "test:watch": "vitest",
    "check:m2": "bash scripts/check-m2.sh",
    "check:m3": "bash scripts/check-m3.sh",
    "check:m4": "bash scripts/check-m4.sh",
    "check:m5": "bash scripts/check-m5.sh",
    "check:m6": "bash scripts/check-m6.sh",
    "check:m7": "bash scripts/check-m7.sh",
    "mcp": "node dist/src/cli/mcp-stdio.js",
    "check:m8": "bash scripts/check-m8.sh"
  },
  "bin": {
    "ipe-mcp": "dist/src/cli/mcp-stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jpeg-js": "0.4.4",
    "pngjs": "^7.0.0",
    "saxes": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "20.19.43",
    "@types/pngjs": "^6.0.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
